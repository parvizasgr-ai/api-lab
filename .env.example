# API Lab konfiqurasiyası — bu faylı .env adı ilə kopyalayın (cp .env.example .env). Hamısı opsionaldır.

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Verilənlər bazası (SQLite faylı). PostgreSQL yalnız sxem səviyyəsində hazırdır — bax: README "PostgreSQL".
DB_PATH=./data/apilab.db

# JWT imza açarı (HS256). Production-da uzun təsadüfi dəyər mütləqdir: openssl rand -hex 32
JWT_SECRET=apilab-dev-secret-change-me-0123456789abcdef

# Ümumi rate limit (sorğu/dəqiqə, subyekt başına). SQL Playground-un öz limiti var (20).
RATE_LIMIT_PER_MIN=60

# X-Simulate tədris simulyatoru (500|503|slow|timeout). Söndürmək üçün: false
SIMULATE_ENABLED=true

# Dərs 3: true → /api/v1/customers Bearer token tələb edir (Dərs 2-də false — tokensiz CRUD)
AUTH_CUSTOMERS=false

# Musiqi: YouTube Data API v3 açarı. Boşdursa yalnız tracks cədvəlində axtarış olur.
# Açar: https://console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# Real Google OAuth (opsional, HƏLƏ İSTİFADƏ OLUNMUR — portal mərhələsi üçün ayrılıb).
# Boşdursa mock "Google" Authorization Server (/oauth/authorize) işləyir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dərs materialları: yüklənmiş faylların yeri (web root-un xaricində)
MATERIALS_DIR=./data/materials
# Konvertasiya alətləri PATH-də deyilsə tam yol (README → "Dərs materialları")
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# SOFFICE_PATH=/usr/bin/soffice
