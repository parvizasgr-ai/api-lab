# API Lab konfiqurasiyası — bu faylı .env adı ilə kopyalayın (cp .env.example .env). Hamısı opsionaldır.

# Server
PORT=3000

# Kim qoşula bilər: 127.0.0.1 — yalnız bu kompüter (default). Sinif/LAN: 0.0.0.0 (docs/classroom-setup.md).
# 0.0.0.0 olanda JWT_SECRET (default olmayan, 32+) və ADMIN_PASSWORD məcburidir — yoxsa server işə düşmür.
HOST=127.0.0.1

# Verilibsə admin parolu hər başlanğıcda və /_reset-dən sonra bununla əvəz olunur (LAN-da məcburi).
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:3000

# Verilənlər bazası (SQLite faylı). PostgreSQL yalnız sxem səviyyəsində hazırdır — bax: README "PostgreSQL".
DB_PATH=./data/apilab.db

# JWT imza açarı (HS256). Production-da uzun təsadüfi dəyər mütləqdir: openssl rand -hex 32
JWT_SECRET=apilab-dev-secret-change-me-0123456789abcdef

# Ümumi rate limit (sorğu/dəqiqə, subyekt başına). SQL Playground-un öz limiti var (20).
RATE_LIMIT_PER_MIN=60

# Brute-force qoruması: eyni username üçün 5 dəqiqədə bu qədər uğursuz login → 429 (pəncərə bitənə qədər)
LOGIN_MAX_FAILURES=10

# X-Forwarded-For yalnız bu proxy-lərdən qəbul olunur (vergüllə: loopback, IP, CIDR). none → heç birindən.
# Server birbaşa açıqdırsa (nginx yoxdur) none qoyun — onda eyni maşındakı proses də IP-ni saxtalaşdıra bilməz.
TRUSTED_PROXIES=loopback

# CORS icazəli origin-lər (vergüllə). Boş → yalnız localhost/127.0.0.1 (istənilən port) və PUBLIC_URL. * → hamısı.
CORS_ORIGINS=

# X-Simulate tədris simulyatoru (500|503|slow|timeout). Söndürmək üçün: false
SIMULATE_ENABLED=true

# Dərs 3: true → /api/v1/customers Bearer token tələb edir (Dərs 2-də false — tokensiz CRUD)
AUTH_CUSTOMERS=false

# Musiqi: YouTube Data API v3 açarı. Boşdursa yalnız tracks cədvəlində axtarış olur.
# Açar: https://console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# Real Google OAuth (opsional, HƏLƏ İSTİFADƏ OLUNMUR — portal mərhələsi üçün ayrılıb).
# Boşdursa mock "Google" Authorization Server (/oauth/authorize) işləyir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dərs materialları: yüklənmiş faylların yeri (web root-un xaricində)
MATERIALS_DIR=./data/materials
# Yükləmə limiti (MB), default 50
MAX_UPLOAD_MB=50
# Konvertasiya alətləri PATH-də deyilsə tam yol (README → "Dərs materialları")
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# SOFFICE_PATH=/usr/bin/soffice

# External APIs (RapidAPI). Standart rejim: hər tələbə öz açarını X-RapidAPI-Key başlığı ilə göndərir.
# RAPIDAPI_KEY — müəllimin açarı: `npm run external:verify` üçün və (açılsa) ehtiyat server key kimi. Heç vaxt commit etməyin.
RAPIDAPI_KEY=
# Server key ehtiyatı: yalnız true olanda, yalnız Hard Limit-li API-lər və daxil olmuş istifadəçilər üçün.
EXTERNAL_SERVER_KEY_ENABLED=false
