{
  "name": "api-lab",
  "version": "0.1.0",
  "private": true,
  "description": "API Lab — tələbələr üçün API təlim platforması (Div Academy, UNEC)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run -s openapi:bundle && tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "npm run -s openapi:bundle && npm run -s postman:export",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract.test.ts tests/security.test.ts",
    "test:web": "npm --prefix web-design run test -- --coverage",
    "test:e2e": "npm --prefix web-design run build && npm --prefix web-design run e2e",
    "test:all": "npm run -s lint && npm run -s typecheck && npm run -s test:coverage && npm run -s test:web && npm run -s test:e2e",
    "lint": "eslint . && npm run -s openapi:lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:shell": "sqlite3 data/apilab.db",
    "materials:seed": "tsx scripts/materials-seed.ts",
    "openapi:lint": "spectral lint openapi/openapi.yaml --fail-severity=warn",
    "openapi:bundle": "tsx scripts/openapi-bundle.ts",
    "postman:export": "tsx scripts/postman-export.ts",
    "rates:refresh": "tsx scripts/rates-refresh.ts",
    "pg:up": "docker compose -f docker-compose.postgres.yml up -d",
    "pg:down": "docker compose -f docker-compose.postgres.yml down"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "swagger-ui-dist": "^5.33.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
