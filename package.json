{
  "name": "api-lab",
  "version": "0.1.0",
  "private": true,
  "description": "API Lab — tələbələr üçün API təlim platforması (Div Academy, UNEC)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run -s openapi:bundle && tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:shell": "sqlite3 data/apilab.db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:lint": "spectral lint openapi/openapi.yaml --fail-severity=warn",
    "openapi:bundle": "tsx scripts/openapi-bundle.ts",
    "lint": "eslint . && npm run -s openapi:lint",
    "rates:refresh": "tsx scripts/rates-refresh.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
